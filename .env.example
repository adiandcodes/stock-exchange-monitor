# Frontend Vite server. Required by artifacts/stock-analyzer/vite.config.ts.
# Use a different port when running the API server at the same time.
PORT=5173

# Vite base path. Use "/" for a standalone local deployment.
BASE_PATH=/

# Optional Node environment. The API dev script sets this automatically.
NODE_ENV=development

# Optional API logger level. Defaults to "info".
LOG_LEVEL=info

# Optional for the current stock application. Required only when using
# @workspace/db or Drizzle database commands.
DATABASE_URL=postgresql://username:password@localhost:5432/stock_exchange_monitor

# Optional. When unset, Replit-only cartographer/dev-banner plugins are skipped.
REPL_ID=